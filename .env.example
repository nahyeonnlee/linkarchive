# 이 파일을 .env 로 복사한 뒤 실제 값을 넣으세요.  (cp .env.example .env)
# .env 는 .gitignore 에 포함되어 커밋되지 않습니다.
#
# 형식: postgresql://<사용자>:<비밀번호>@<서버이름>.postgres.database.azure.com:5432/<DB이름>?sslmode=require
# 비밀번호에 @ : / # ? % 같은 특수문자가 있으면 URL 인코딩 필요 (예: @ → %40, # → %23)
DATABASE_URL=postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/postgres?sslmode=require
